# Phase 01 reads process environment; .env is NOT automatically loaded.
# Optional non-secret settings:
# SENTINEL_DATABASE_PATH=backend/local.sqlite
# SENTINEL_ENV=development
# Synthetic input cannot be enabled through environment variables or HTTP.
# Credentials use hidden prompts in the offline provisioning CLI.
# GEMINI_API_KEY=replace_with_your_key_only_when_phase_02_is_authorized

# Phase 02: opt in explicitly. No automatic live-to-mock fallback.
SENTINEL_PROVIDER_MODE=DISABLED
SENTINEL_ALLOW_BILLABLE=false
GEMINI_MODEL=gemini-3.6-flash
# Set your own key privately only after billable-call approval; never commit it.
# GEMINI_API_KEY=replace_with_your_private_key
SENTINEL_MEDIA_ROOT=backend/private_media
SENTINEL_MAX_IMAGE_BYTES=5242880
SENTINEL_MAX_IMAGE_PIXELS=4000000
SENTINEL_MAX_IMAGE_DIMENSION=4096
SENTINEL_PROVIDER_TIMEOUT_SECONDS=20
SENTINEL_PROVIDER_ATTEMPTS=1
